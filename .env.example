# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth  (https://github.com/settings/developers → New OAuth App)
GITHUB_ID=
GITHUB_SECRET=

# Base de datos PostgreSQL (Neon, Supabase, Vercel Postgres o local)
DATABASE_URL=postgresql://usuario:password@host:5432/basedatos?sslmode=require

# NextAuth  (genera uno en https://generate-secret.vercel.app/32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Bloqueo por intentos fallidos (opcional)
MAX_LOGIN_ATTEMPTS=3
LOCK_MINUTES=5
